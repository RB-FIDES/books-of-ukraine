{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Memory System Status Check",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Write-Host '🧠 Memory System Status:'; Get-ChildItem ai/*.md | ForEach-Object { Write-Host \"📄 $($_.Name): $(Get-Date $_.LastWriteTime -Format 'yyyy-MM-dd HH:mm')\" }"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Load Memory Functions (R)",
      "type": "shell", 
      "command": "Rscript",
      "args": [
        "-e",
        "source('./scripts/ai-memory-functions-core.R'); ai_memory_check()"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always", 
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Project Files Overview",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Write-Host '📁 Project Structure:'; tree /F /A | head -30"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false, 
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}



