// For format details, see https://aka.ms/devcontainer.json
// For config options, see the README at:
// https://github.com/rocker-org/devcontainer-templates/tree/main/src/r-ver
{
  "name": "books-of-ukraine",
  // Use Dockerfile build (root-level dockerFile property expected by some schemas),
  "image": "books-of-ukraine:v8",
  "forwardPorts": [8787],
  "remoteUser": "admin",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "portsAttributes": {
    "8787": {
      "label": "RStudio Server",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash" },
          "R": { "path": "/usr/local/bin/R", "args": ["--no-save", "--quiet"], "icon": "symbol-method" },
          "PowerShell": { "path": "pwsh", "icon": "terminal-powershell" }
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
  // Optional: add mounts, env vars, features below
}